bool intersectSphere(const Ray&r,const RenderObject&o,float mn,float mx,Hit&h){Vec3 oc=r.origin-o.position;float a=dot(r.direction,r.direction),hb=dot(oc,r.direction),c=dot(oc,oc)-o.size*o.size,disc=hb*hb-a*c;if(disc<0)return false;float q=std::sqrt(disc),t=(-hb-q)/a;if(t<mn||t>mx){t=(-hb+q)/a;if(t<mn||t>mx)return false;}h.found=true;h.t=t;h.point=r.origin+r.direction*t;h.normal=normalise(h.point-o.position);h.colour=o.colour;return true;}
bool intersectCube(const Ray&r,const RenderObject&o,float mn,float mx,Hit&h){Vec3 org=r.origin-o.position;float half[3]={o.size,o.size,o.height*.5f},orig[3]={org.x,org.y,org.z},dir[3]={r.direction.x,r.direction.y,r.direction.z};float nearT=mn,farT=mx;int axis=-1;float sign=0;for(int a=0;a<3;++a){if(std::fabs(dir[a])<1e-7f){if(orig[a]<-half[a]||orig[a]>half[a])return false;continue;}float inv=1/dir[a],t0=(-half[a]-orig[a])*inv,t1=(half[a]-orig[a])*inv,s=-1;if(t0>t1){std::swap(t0,t1);s=1;}if(t0>nearT){nearT=t0;axis=a;sign=s;}farT=std::min(farT,t1);if(farT<nearT)return false;}if(axis<0)return false;h.found=true;h.t=nearT;h.point=r.origin+r.direction*nearT;h.normal=axis==0?Vec3(sign,0,0):axis==1?Vec3(0,sign,0):Vec3(0,0,sign);h.colour=o.colour;return true;}
bool intersectTriangle(const Ray&r,const Vec3&a,const Vec3&b,const Vec3&c,float mn,float mx,float&t,Vec3&n){Vec3 e1=b-a,e2=c-a,p=cross(r.direction,e2);float det=dot(e1,p);if(std::fabs(det)<1e-7f)return false;float inv=1/det;Vec3 s=r.origin-a;float u=dot(s,p)*inv;if(u<0||u>1)return false;Vec3 q=cross(s,e1);float v=dot(r.direction,q)*inv;if(v<0||u+v>1)return false;t=dot(e2,q)*inv;if(t<mn||t>mx)return false;n=normalise(cross(e1,e2));if(dot(n,r.direction)>0)n=n*-1;return true;}
bool intersectPyramid(const Ray&r,const RenderObject&o,float mn,float mx,Hit&h){float s=o.size,z0=o.position.z-o.height*.5f,z1=o.position.z+o.height*.5f;Vec3 p0={o.position.x-s,o.position.y-s,z0},p1={o.position.x+s,o.position.y-s,z0},p2={o.position.x+s,o.position.y+s,z0},p3={o.position.x-s,o.position.y+s,z0},ap={o.position.x,o.position.y,z1};Vec3 tris[6][3]={{p0,p2,p1},{p0,p3,p2},{p0,p1,ap},{p1,p2,ap},{p2,p3,ap},{p3,p0,ap}};bool found=false;float closest=mx;Vec3 nn;for(int i=0;i<6;++i){float t;Vec3 n;if(intersectTriangle(r,tris[i][0],tris[i][1],tris[i][2],mn,closest,t,n)){found=true;closest=t;nn=n;}}if(!found)return false;h.found=true;h.t=closest;h.point=r.origin+r.direction*closest;h.normal=nn;h.colour=o.colour;return true;}
bool intersectCone(const Ray&r,const RenderObject&o,float mn,float mx,Hit&h){float radius=o.size,height=o.height,half=height*.5f,slope=radius/height,s2=slope*slope;Vec3 origin=r.origin-o.position,d=r.direction;float apex=half;float a=d.x*d.x+d.y*d.y-s2*d.z*d.z,b=2*(origin.x*d.x+origin.y*d.y+s2*(apex-origin.z)*d.z),c=origin.x*origin.x+origin.y*origin.y-s2*(apex-origin.z)*(apex-origin.z);bool found=false;float closest=mx;Vec3 nn;float disc=b*b-4*a*c;if(std::fabs(a)>1e-7f&&disc>=0){float root=std::sqrt(disc),roots[2]={(-b-root)/(2*a),(-b+root)/(2*a)};for(float t:roots){if(t<mn||t>closest)continue;Vec3 p=origin+d*t;if(p.z<-half||p.z>half)continue;found=true;closest=t;nn=normalise({p.x,p.y,s2*(apex-p.z)});}}if(std::fabs(d.z)>1e-7f){float t=(-half-origin.z)/d.z;if(t>=mn&&t<=closest){Vec3 p=origin+d*t;if(p.x*p.x+p.y*p.y<=radius*radius){found=true;closest=t;nn={0,0,-1};}}}if(!found)return false;if(dot(nn,r.direction)>0)nn=nn*-1;h.found=true;h.t=closest;h.point=r.origin+r.direction*closest;h.normal=nn;h.colour=o.colour;return true;}
const std::vector<Vec3>& dodecaNormals(){static std::vector<Vec3>n;if(!n.empty())return n;float phi=(1+std::sqrt(5.0f))*.5f;for(int a:{-1,1})for(int b:{-1,1}){n.push_back(normalise({0,float(a),float(b)*phi}));n.push_back(normalise({float(a),float(b)*phi,0}));n.push_back(normalise({float(a)*phi,0,float(b)}));}return n;}
const std::vector<Vec3>& icosaNormals(){static std::vector<Vec3>n;if(!n.empty())return n;float phi=(1+std::sqrt(5.0f))*.5f,ip=1/phi;for(int x:{-1,1})for(int y:{-1,1})for(int z:{-1,1})n.push_back(normalise({float(x),float(y),float(z)}));for(int a:{-1,1})for(int b:{-1,1}){n.push_back(normalise({0,float(a)*ip,float(b)*phi}));n.push_back(normalise({float(a)*ip,float(b)*phi,0}));n.push_back(normalise({float(a)*phi,0,float(b)*ip}));}return n;}
bool intersectPoly(const Ray&r,const RenderObject&o,const std::vector<Vec3>&normals,float mn,float mx,Hit&h){Vec3 org=r.origin-o.position;float enter=mn,exit=mx;Vec3 nn;bool have=false;for(const auto&n:normals){float den=dot(r.direction,n),dist=o.size-dot(org,n);if(std::fabs(den)<1e-7f){if(dist<0)return false;continue;}float t=dist/den;if(den<0){if(t>enter){enter=t;nn=n;have=true;}}else exit=std::min(exit,t);if(enter>exit)return false;}if(!have||enter<mn||enter>mx)return false;h.found=true;h.t=enter;h.point=r.origin+r.direction*enter;h.normal=nn;h.colour=o.colour;return true;}
bool intersectObject(const Ray&r,const RenderObject&o,float mn,float mx,Hit&h){switch(o.kind){case ShapeKind::Cube:return intersectCube(r,o,mn,mx,h);case ShapeKind::Sphere:return intersectSphere(r,o,mn,mx,h);case ShapeKind::Cone:return intersectCone(r,o,mn,mx,h);case ShapeKind::Pyramid:return intersectPyramid(r,o,mn,mx,h);case ShapeKind::Dodecahedron:return intersectPoly(r,o,dodecaNormals(),mn,mx,h);case ShapeKind::Icosahedron:return intersectPoly(r,o,icosaNormals(),mn,mx,h);}return false;}
Vec3 floorColour(const LevelDefinition&l,const Vec3&p){int x=int(std::floor(p.x+20)),y=int(std::floor(p.y+20));Vec3 c=((x+y)&1)?l.floorDark:l.floorLight;float ex=std::fabs(p.x-std::round(p.x)),ey=std::fabs(p.y-std::round(p.y));if(std::min(ex,ey)<.022f)c=c*.78f;return c;}
bool intersectGround(const Ray&r,const LevelDefinition&l,float mn,float mx,Hit&h){if(std::fabs(r.direction.z)<1e-7f)return false;float t=-r.origin.z/r.direction.z;if(t<mn||t>mx)return false;Vec3 p=r.origin+r.direction*t;if(std::fabs(p.x)>GROUND_LIMIT||std::fabs(p.y)>GROUND_LIMIT)return false;h.found=true;h.t=t;h.point=p;h.normal={0,0,1};h.colour=floorColour(l,p);h.ground=true;return true;}
Hit traceClosest(const LevelDefinition&l,const Ray&r,float mn,float mx){Hit out;for(const auto&o:l.objects){Hit h;if(intersectObject(r,o,mn,mx,h)){out=h;mx=h.t;}}Hit g;if(intersectGround(r,l,mn,mx,g))out=g;return out;}
bool occluded(const LevelDefinition&l,Vec3 p,Vec3 n){Vec3 to=l.lightPosition-p;float dist=length(to);return traceClosest(l,{p+n*EPSILON,to/dist},EPSILON,dist-EPSILON).found;}
Vec3 shade(const LevelDefinition&l,const Hit&h){Vec3 to=l.lightPosition-h.point;float dist=length(to),diff=std::max(0.0f,dot(h.normal,to/dist)),att=1/(1+.018f*dist*dist),vis=occluded(l,h.point,h.normal)?0:1;Vec3 c=h.colour*(.19f+vis*diff*att*1.18f);return{std::min(c.x,1.0f),std::min(c.y,1.0f),std::min(c.z,1.0f)};}
Vec3 background(float y){float t=std::max(0.0f,std::min(1.0f,y));return Vec3(.075f,.12f,.18f)*(1-t)+Vec3(.20f,.28f,.34f)*t;}
Vec3 trace(float px,float py){Vec3 f=cameraForward(),r=normalise(cross(f,{0,0,1})),u=normalise(cross(r,f));float a=float(frameWidth)/frameHeight,vh=viewHeight(),vw=vh*a,sx=(px/frameWidth-.5f)*vw,sy=(.5f-py/frameHeight)*vh;Vec3 focus=canPan()?BASE_FOCUS+Vec3(cameraPanX,cameraPanY,0):BASE_FOCUS;Ray ray={focus-f*9+r*sx+u*sy,f};const auto&l=activeLevel();Hit h=traceClosest(l,ray,EPSILON,FAR_DISTANCE);return h.found?shade(l,h):background(py/frameHeight);}
std::uint8_t byte(float v){v=std::pow(std::max(0.0f,std::min(1.0f,v)),1/2.2f);return std::uint8_t(v*255+.5f);}

float segDist(float px,float py,float ax,float ay,float bx,float by){float x=bx-ax,y=by-ay,q=x*x+y*y,t=q>0?std::max(0.0f,std::min(1.0f,((px-ax)*x+(py-ay)*y)/q)):0,dx=px-(ax+x*t),dy=py-(ay+y*t);return std::sqrt(dx*dx+dy*dy);}
